{
  "name": "@marufzak/strapi-ui",
  "version": "1.0.0",
  "description": "Headless UI components built with @marufzak/react and Tailwind CSS packages",
  "main": "./dist/components/index.js",
  "types": "./dist/components/index.d.ts",
  "scripts": {
    "watch": "NODE_ENV=development rollup -c -w",
    "build": "NODE_ENV=production webpack"
  },
  "author": {
    "email": "marufzak04@gmail.com",
    "name": "Ma'ruf Zakirov",
    "url": "https://github.com/MarufZak"
  },
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.1",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "glob": "^11.0.0",
    "postcss": "^8.5.6",
    "rollup": "^4.28.0",
    "rollup-plugin-delete": "^2.1.0",
    "rollup-plugin-postcss": "^4.0.2",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.15",
    "tslib": "^2.8.1",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  },
  "peerDependencies": {
    "@marufzak/react": "1.0.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "default": "./dist/components/index/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./icons": {
      "default": "./dist/icons/index/index.js",
      "types": "./dist/icons/index.d.ts"
    },
    "./icons/logos": {
      "default": "./dist/icons/logos/index/index.js",
      "types": "./dist/icons/logos/index.d.ts"
    },
    "./utils": {
      "default": "./dist/utils/index.js",
      "types": "./dist/utils.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/components/index.d.ts"
      ],
      "icons": [
        "./dist/icons/index.d.ts"
      ],
      "icons/logos": [
        "./dist/icons/logos/index.d.ts"
      ],
      "utils": [
        "./dist/utils.d.ts"
      ]
    }
  }
}
