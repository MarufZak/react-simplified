{
  "name": "@marufzak/strapi-ui",
  "version": "1.0.0",
  "description": "Headless UI components built with @marufzak/react and Tailwind CSS packages",
  "main": "./dist/components/index.js",
  "types": "./dist/components/index.d.ts",
  "scripts": {
    "watch": "NODE_ENV=development rollup -c -w",
    "build": "NODE_ENV=production webpack && rm dist/styles.css.js"
  },
  "author": {
    "email": "marufzak04@gmail.com",
    "name": "Ma'ruf Zakirov",
    "url": "https://github.com/MarufZak"
  },
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.1",
    "autoprefixer": "^10.4.23",
    "clsx": "^2.1.1",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.4",
    "glob": "^11.0.0",
    "mini-css-extract-plugin": "^2.9.4",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "postcss-preset-env": "^10.5.0",
    "rollup": "^4.28.0",
    "rollup-plugin-delete": "^2.1.0",
    "rollup-plugin-postcss": "^4.0.2",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.15",
    "tslib": "^2.8.1",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  },
  "peerDependencies": {
    "@marufzak/react": "1.0.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "default": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./icons": {
      "default": "./dist/icons/index.js",
      "types": "./dist/icons/index.d.ts"
    },
    "./icons/logos": {
      "default": "./dist/icons/logos/index.js",
      "types": "./dist/icons/index.d.ts"
    },
    "./utils": {
      "default": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    },
    "./styles": "./src/globals.css"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/components/index.d.ts"
      ],
      "icons": [
        "./dist/icons/index.d.ts"
      ],
      "icons/logos": [
        "./dist/icons/logos/index.d.ts"
      ],
      "utils": [
        "./dist/utils.d.ts"
      ]
    }
  }
}
