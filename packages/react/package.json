{
  "name": "@marufzak/react",
  "version": "1.0.0",
  "description": "Zero-dependency, lightweight and minimalistic implementation of the React library",
  "keywords": [
    "react",
    "ui",
    "library",
    "no-dependencies",
    "lightweight"
  ],
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "scripts": {
    "dev": "NODE_ENV=development webpack --watch",
    "build": "NODE_ENV=production webpack"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.0",
    "@types/node": "^22.10.1",
    "@types/prop-types": "^15.7.13",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^13.0.1",
    "csstype": "^3.1.3",
    "prettier": "^3.4.1",
    "prop-types": "^15.8.1",
    "ts-loader": "^9.5.4",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-manifest-plugin": "^6.0.1"
  },
  "author": {
    "email": "marufzak04@gmail.com",
    "name": "Ma'ruf Zakirov",
    "url": "https://github.com/MarufZak"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "default": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./types": {
      "default": "./dist/types/index.d.ts",
      "types": "./dist/types/index.d.ts"
    },
    "./dom": {
      "default": "./dist/dom/index.js",
      "types": "./dist/dom/index.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "types": [
        "./dist/types/index.d.ts"
      ],
      "dom": [
        "./dist/dom/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ]
}
